{
  "name": "@welcomer-bot/utils",
  "version": "0.2.0",
  "description": "Shared defaults for the Welcomer dashboard and bot",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "lint": "oxlint",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "test": "vitest run"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Welcomer-Bot/utils.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "keywords": [
    "welcomer",
    "bot"
  ],
  "author": "Welcomer-Bot",
  "license": "MIT",
  "packageManager": "yarn@4.18.1",
  "dependencies": {
    "discord-api-types": "^0.38.59"
  },
  "devDependencies": {
    "@types/node": "^24",
    "oxlint": "^1.93.0",
    "typescript": "^5",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
